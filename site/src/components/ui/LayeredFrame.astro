---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<div class:list={["layered-frame", className]}>
  <slot />
</div>

<style>
  .layered-frame {
    border-style: solid;
    border-width: 16px;
    border-image-source: url("/ui/frame.png");
    border-image-slice: 32 fill;
    border-image-width: 16px;
    border-image-repeat: stretch;
    padding: 12px;
  }
</style>
